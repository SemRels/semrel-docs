---
// This code has been partially generated by an AI.
// Custom Head override: injects Twitter title/description and BreadcrumbList + TechArticle JSON-LD
// without duplicating Starlight's native canonical, og:title, og:description, or og:url tags.
import type { Props } from '@astrojs/starlight/props';
import StarlightHead from '@astrojs/starlight/components/Head.astro';
import CookieConsent from './CookieConsent.astro';

const { entry } = Astro.props as Props;
const frontmatter = entry?.data ?? {};
const pageTitle = (frontmatter as { title?: string }).title ?? 'semrel';
const pageDesc  = (frontmatter as { description?: string }).description ??
  'semrel automates semantic versioning and release management using Conventional Commits and 46 official plugins — zero Node.js dependency.';
const siteOrigin = Astro.site ?? new URL('https://www.semrel.io');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const isDe = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/de/' || Astro.url.pathname === '/de';
const twitterTitle = pageTitle.includes('semrel') ? pageTitle : `${pageTitle} | semrel`;

// Build BreadcrumbList JSON-LD for all documentation subpages
const rawSegments = Astro.url.pathname.split('/').filter(Boolean);
const contentSegments = isDe ? rawSegments.slice(1) : rawSegments;
const homeUrl = isDe ? new URL('/de/', siteOrigin).toString() : new URL('/', siteOrigin).toString();
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'semrel',
    item: homeUrl,
  },
  ...contentSegments.map((seg, idx) => {
    const pathSlice = (isDe ? ['de', ...contentSegments.slice(0, idx + 1)] : contentSegments.slice(0, idx + 1)).join('/');
    const isLast = idx === contentSegments.length - 1;
    const label = isLast
      ? pageTitle
      : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    return {
      '@type': 'ListItem',
      position: idx + 2,
      name: label,
      item: new URL(`/${pathSlice}/`, siteOrigin).toString(),
    };
  }),
];

const breadcrumbSchema = !isHome && breadcrumbItems.length > 1
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems,
    })
  : null;

const techArticleSchema = !isHome
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: twitterTitle,
      description: pageDesc,
      url: canonicalURL,
      inLanguage: isDe ? 'de-DE' : 'en-US',
      author: {
        '@type': 'Organization',
        name: 'SemRels',
        url: 'https://github.com/SemRels',
      },
      publisher: {
        '@type': 'Organization',
        name: 'SemRels',
        logo: {
          '@type': 'ImageObject',
          url: new URL('/semrel.png', siteOrigin).toString(),
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL,
      },
    })
  : null;
---
<StarlightHead {...Astro.props}><slot /></StarlightHead>

<!-- Dynamic per-page Twitter title & description (Starlight already emits canonical, og:title, og:description, og:url) -->
<meta name="twitter:title" content={twitterTitle} />
<meta name="twitter:description" content={pageDesc} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

{breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
{techArticleSchema && <script type="application/ld+json" set:html={techArticleSchema} />}

<CookieConsent />

