---
// This code has been fully generated by an AI.
import StarlightFooter from '@astrojs/starlight/components/Footer.astro';

const isDe = Astro.url.pathname.startsWith('/de/');
const privacyPath = isDe ? '/de/legal/privacy/' : '/legal/privacy/';
---

<StarlightFooter />

<div class="cookie-footer" aria-label={isDe ? 'Datenschutz und Cookies' : 'Privacy and cookies'}>
  <button type="button" data-cookie-preferences>
    {isDe ? 'Cookie-Einstellungen' : 'Cookie settings'}
  </button>
  <a href={privacyPath}>{isDe ? 'Datenschutzerklärung' : 'Privacy policy'}</a>
</div>

<section class="cookie-banner" data-cookie-banner hidden role="region" aria-labelledby="cookie-title">
  <div class="cookie-copy">
    <h2 id="cookie-title">{isDe ? 'Analyse-Cookies' : 'Analytics cookies'}</h2>
    <p>
      {isDe
        ? 'Wir laden Google Analytics nur, wenn du zustimmst. Du kannst deine Auswahl jederzeit in den Cookie-Einstellungen ändern.'
        : 'We load Google Analytics only if you consent. You can change your choice at any time in cookie settings.'}
    </p>
    <a href={privacyPath}>{isDe ? 'Mehr in der Datenschutzerklärung' : 'Read the privacy policy'}</a>
  </div>
  <div class="cookie-actions">
    <button type="button" data-cookie-reject>
      {isDe ? 'Nur notwendige' : 'Only necessary'}
    </button>
    <button type="button" data-cookie-accept>
      {isDe ? 'Alle akzeptieren' : 'Accept all'}
    </button>
    <button
      type="button"
      class="cookie-settings-button"
      data-cookie-settings
      aria-controls="cookie-settings"
      aria-expanded="false"
    >
      {isDe ? 'Einstellungen anpassen' : 'Customize settings'}
    </button>
  </div>
  <div class="cookie-settings-panel" id="cookie-settings" data-cookie-settings-panel hidden>
    <p>
      <strong>{isDe ? 'Notwendig' : 'Necessary'}</strong>
      {isDe
        ? 'Die Auswahl wird lokal in deinem Browser gespeichert, damit dieser Hinweis nicht bei jedem Seitenaufruf erneut erscheint.'
        : 'Your choice is stored locally in your browser so this notice does not appear on every page.'}
    </p>
    <label>
      <input type="checkbox" data-cookie-analytics />
      <span>
        <strong>{isDe ? 'Statistik & Analyse' : 'Statistics & analytics'}</strong>
        {isDe
          ? 'Google Analytics 4 (Google); Cookies: _ga und _ga_*; Speicherdauer: maximal 14 Monate. Rechtsgrundlage: deine Einwilligung. Du kannst sie jederzeit widerrufen.'
          : 'Google Analytics 4 (Google); cookies: _ga and _ga_*; retention: up to 14 months. Legal basis: your consent, which you can withdraw at any time.'}
      </span>
    </label>
    <button type="button" class="cookie-save-button" data-cookie-save>
      {isDe ? 'Auswahl speichern' : 'Save selection'}
    </button>
  </div>
</section>

<style is:global>
  .cookie-footer {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin: 1rem 0 2rem;
    font-size: var(--sl-text-sm);
  }

  .cookie-footer button {
    border: 0;
    padding: 0;
    color: var(--sl-color-text-accent);
    background: transparent;
    text-decoration: underline;
    cursor: pointer;
    font: inherit;
  }

  .cookie-banner {
    position: fixed;
    z-index: 1000;
    inset: auto 1rem 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    max-width: 62rem;
    margin-inline: auto;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.75rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 28%);
  }

  .cookie-banner[hidden],
  .cookie-settings-panel[hidden] {
    display: none;
  }

  .cookie-copy h2 {
    margin: 0 0 0.35rem;
    font-size: var(--sl-text-lg);
  }

  .cookie-copy p,
  .cookie-settings-panel p {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-sm);
  }

  .cookie-copy a {
    font-size: var(--sl-text-sm);
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .cookie-actions button,
  .cookie-save-button {
    min-height: 2.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    padding: 0.5rem 0.75rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    font: inherit;
    cursor: pointer;
  }

  .cookie-actions button:hover,
  .cookie-save-button:hover {
    background: var(--sl-color-gray-6);
  }

  .cookie-actions .cookie-settings-button {
    border-color: transparent;
    text-decoration: underline;
  }

  .cookie-settings-panel {
    grid-column: 1 / -1;
    border-top: 1px solid var(--sl-color-gray-4);
    padding-top: 1rem;
  }

  .cookie-settings-panel label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin: 0.75rem 0;
    font-size: var(--sl-text-sm);
  }

  .cookie-settings-panel input {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    accent-color: var(--sl-color-text-accent);
  }

  .cookie-save-button {
    margin-top: 0.25rem;
  }

  .cookie-banner button:focus-visible,
  .cookie-footer button:focus-visible,
  .cookie-footer a:focus-visible,
  .cookie-banner a:focus-visible,
  .cookie-settings-panel input:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }

  @media (max-width: 42rem) {
    .cookie-banner {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      inset-inline: 0.5rem;
      bottom: 0.5rem;
      padding: 1rem;
    }

    .cookie-actions {
      justify-content: stretch;
    }

    .cookie-actions button {
      flex: 1 1 45%;
    }

    .cookie-actions .cookie-settings-button {
      flex-basis: 100%;
    }
  }
</style>
