{
  "name": "semrel-docs",
  "type": "module",
  "version": "0.1.0",
  "description": "Documentation & website for semrel",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docs:parity": "node scripts/check-docs-parity.mjs",
    "test:docs": "node --test scripts/check-docs-parity.test.mjs",
    "check:docs": "npm run test:docs && npm run docs:parity",
    "lighthouse": "node scripts/lighthouse-all.js",
    "lighthouse:build": "node scripts/lighthouse-all.js --build",
    "lighthouse:seo": "node scripts/lighthouse-all.js --build --categories seo,accessibility",
    "lighthouse:quick": "node scripts/lighthouse-all.js --build --max-pages 5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.4",
    "astro-compress": "^2.4.3",
    "astro-compressor": "^1.3.0",
    "playwright": "^1.60.0",
    "rehype-mermaid": "^3.0.0",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0"
  },
  "overrides": {
    "astro": "$astro",
    "brace-expansion": ">=2.1.4",
    "deepmerge-ts": ">=8.0.0",
    "dompurify": ">=3.4.13",
    "esbuild": ">=0.28.1",
    "js-yaml": "4.3.1",
    "mermaid": ">=11.16.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "sharp": ">=0.35.0",
    "svgo": ">=4.0.2"
  }
}
